<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingBottom="32dp">

    <!-- 拖曳把手 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <!-- 擁有者操作列（僅 creator 可見） -->
    <LinearLayout
        android:id="@+id/llOwnerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnEditSpot"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_edit_spot"
            android:src="@drawable/ic_edit"
            android:tint="#555555" />

        <ImageButton
            android:id="@+id/btnDeleteSpot"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_delete_spot"
            android:src="@drawable/ic_delete"
            android:tint="#F44062" />

    </LinearLayout>

    <!-- 景點名稱 -->
    <TextView
        android:id="@+id/tvSpotName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="景點名稱"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <!-- 分類 Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="類別"
        android:clickable="false"
        android:focusable="false"
        app:chipBackgroundColor="#FFF0F3"
        app:chipCornerRadius="16dp"
        android:textColor="#F44062"
        app:chipStrokeColor="#F44062"
        app:chipStrokeWidth="1dp" />

    <!-- 地址 -->
    <TextView
        android:id="@+id/tvSpotAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:text="地址"
        android:textSize="14sp"
        android:textColor="#555555"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawablePadding="6dp" />

    <!-- 評分（有值才顯示） -->
    <TextView
        android:id="@+id/tvSpotRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- 加入列表按鈕 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToList"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/label_add_to_itin"
        android:textColor="@android:color/white"
        app:backgroundTint="#F44062"
        app:cornerRadius="24dp" />

</LinearLayout>
