<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="#DDDDDD" />

        <!-- 標題（由程式碼設定） -->
        <TextView
            android:id="@+id/tvSpotSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="新增景點"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <!-- 圖片預覽 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ivSpotImagePreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 選擇圖片按鈕 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickImage"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp"
            android:text="選擇圖片"
            android:textColor="#F44062"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_photo"
            app:iconTint="#F44062"
            app:strokeColor="#F44062" />

        <!-- 景點名稱 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpotName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:hint="景點名稱（必填）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpotName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 分類 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpotCategory"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:hint="分類（可選）">

            <AutoCompleteTextView
                android:id="@+id/actvSpotCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 地址 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpotAddress"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:hint="地址（可選）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpotAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 緯度 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpotLat"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:hint="緯度">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpotLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 經度 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSpotLng"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:hint="經度">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpotLng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 是否公開 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="公開景點（讓其他人也能看見）"
                android:textSize="14sp"
                android:textColor="#444444" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSpotPublic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="#F44062"
                app:trackTint="#FFBBCC" />

        </LinearLayout>

        <!-- 按鈕列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSpot"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:text="取消"
                android:textColor="#F44062"
                app:cornerRadius="24dp"
                app:strokeColor="#F44062" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSpot"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="儲存"
                android:textSize="15sp"
                app:backgroundTint="#F44062"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <!-- 儲存中 -->
        <ProgressBar
            android:id="@+id/pbSavingSpot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
