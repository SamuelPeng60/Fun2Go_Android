<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fun2Go">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fun2Go">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ItineraryDetailActivity"
            android:label="行程詳情"
            android:theme="@style/Theme.Fun2Go" />

        <activity
            android:name=".ui.ItineraryListActivity"
            android:label="我的行程"
            android:theme="@style/Theme.Fun2Go" />

        <activity
            android:name=".ui.VehicleListActivity"
            android:label="租車"
            android:theme="@style/Theme.Fun2Go"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.OrderListActivity"
            android:label="我的訂單"
            android:theme="@style/Theme.Fun2Go"
            android:parentActivityName=".ui.VehicleListActivity" />

        <activity
            android:name=".ui.PublicItineraryListActivity"
            android:label="探索行程"
            android:theme="@style/Theme.Fun2Go"
            android:parentActivityName=".ui.MainActivity" />
    </application>

</manifest>